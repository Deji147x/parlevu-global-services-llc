# Claude Code local settings
.claude/

# Environment variables (API keys, secrets)
.env
.env.local
.env.*.local

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor files
*.swp
*.swo
.vscode/
.idea/

# Python build artifacts
__pycache__/
*.py[cod]

# publish lock (runtime)
.publish.lock

# publish run logs
logs/

# .env backups and variants. set_buffer_token.py writes .env.bak, a full
# copy of the previous .env including live credentials; the bare ".env"
# rule above does not cover it. .env.example stays tracked on purpose.
.env.*
!.env.example
